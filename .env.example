# LLM Provider Configuration ('gemini' or 'mock')
LLM_PROVIDER=gemini

# Gemini API Key (Required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./prove.db

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Frontend API URL (used by Vite build; set to deployed backend URL in production)
# Local development default: http://localhost:8000/api
VITE_API_URL=http://localhost:8000/api
